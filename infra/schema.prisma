generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model users {
  id            Int        @id @default(autoincrement())
  nome          String
  email         String     @unique
  senha         String
  criado_em     DateTime   @default(now())
  atualizado_em DateTime   @default(now())
  perfil_id     Int
  sessions      sessions[]
  perfil        perfis     @relation(fields: [perfil_id], references: [id])
}

model sessions {
  id        String   @id @default(uuid()) @db.VarChar(36)
  token     String   @unique @db.VarChar(96)
  user_id   Int
  criado_em DateTime @default(now())
  expira_em DateTime
  usuario   users    @relation(fields: [user_id], references: [id])
}

model perfis {
  id            Int      @id @default(autoincrement())
  nome          String
  permissoes    String[]
  atualizado_em DateTime @default(now())
  usuarios      users[]
}

model registros {
  id              Int           @id @default(autoincrement())
  nome            String
  status          Boolean       @default(true)
  tipo_registro   tipo_registro
  email           String?
  whatsapp        String?
  cpf             String?       @unique
  cnpj            String?       @unique
  ie              String?
  data_nascimento DateTime?
  cep             String?
  logradouro      String?
  numero          String?
  complemento     String?
  bairro          String?
  cidade          String?
  estado          String?
  criado_em       DateTime      @default(now())
  atualizado_em   DateTime      @default(now())
  tabela_id       Int           @default(1)
  tabela          tabela        @relation(fields: [tabela_id], references: [id])
}

model categorias {
  id            Int        @id @default(autoincrement())
  nome          String
  atualizado_em DateTime   @default(now())
  criado_em     DateTime   @default(now())
  status        Boolean    @default(true)
  materiais     material[]
}

model material {
  id            Int               @id @default(autoincrement())
  categoria_id  Int
  nome          String
  preco_venda   Decimal           @db.Decimal(10, 2)
  status        Boolean           @default(true)
  atualizado_em DateTime          @default(now())
  criado_em     DateTime          @default(now())
  categoria     categorias        @relation(fields: [categoria_id], references: [id])
  tabelas       material_tabela[]
}

model tabela {
  id            Int               @id @default(autoincrement())
  nome          String
  criado_em     DateTime          @default(now())
  atualizado_em DateTime          @default(now())
  materiais     material_tabela[]
  registros     registros[]
}

model material_tabela {
  id            Int      @id @default(autoincrement())
  tabela_id     Int
  material_id   Int
  preco_compra  Decimal  @db.Decimal(10, 2)
  atualizado_em DateTime @default(now())
  material      material @relation(fields: [material_id], references: [id])
  tabela        tabela   @relation(fields: [tabela_id], references: [id])
}

enum tipo_registro {
  F
  J
}
